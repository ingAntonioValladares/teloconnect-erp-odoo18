<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Categoría del Módulo -->
        <record id="module_category_teloconnect" model="ir.module.category">
            <field name="name">TeloConnect ERP</field>
            <field name="sequence">10</field>
        </record>

        <!-- Grupo 1: Operador Back Office -->
        <record id="group_teloconnect_backoffice_operator" model="res.groups">
            <field name="name">Operador Back Office</field>
            <field name="category_id" ref="module_category_teloconnect"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo 2: Gestor de Almacén -->
        <record id="group_teloconnect_almacen_manager" model="res.groups">
            <field name="name">Gestor de Almacén</field>
            <field name="category_id" ref="module_category_teloconnect"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo 3: Administrador -->
        <record id="group_teloconnect_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_teloconnect"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>