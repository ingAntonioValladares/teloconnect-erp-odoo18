<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="view_teloconnect_almacen_form" model="ir.ui.view">
            <field name="name">teloconnect.almacen.form</field>
            <field name="model">teloconnect.almacen</field>
            <field name="arch" type="xml">
                <form string="Despacho de Almacén">
                    <header>
                        <button name="action_assign_equipment" 
                                string="Asignar Equipos" 
                                type="object" 
                                class="oe_highlight" 
                                invisible="state != 'pendiente_asig'"/>
                        
                        <button name="action_dispatch" 
                                string="Despachar" 
                                type="object" 
                                class="oe_highlight" 
                                invisible="state != 'equipos_asignados'"/>
                        
                        <button name="action_mark_delivered" 
                                string="Entregar a Técnico" 
                                type="object" 
                                class="oe_highlight" 
                                invisible="state != 'despachado'"/>
                        
                        <field name="state" widget="statusbar" statusbar_visible="pendiente_asig,equipos_asignados,despachado,entregado_tecnico"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información General">
                                <field name="backoffice_id"/>
                                <field name="client_name"/>
                                <field name="installation_address"/>
                            </group>
                            <group string="Requerimientos y Técnico">
                                <field name="required_decos"/>
                                <field name="required_repeaters"/>
                                <field name="technician_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Series y MAC Address">
                                <group>
                                    <field name="deco_series"/>
                                    <field name="repeater_series"/>
                                </group>
                            </page>
                            <page string="Observaciones">
                                <field name="technician_notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_teloconnect_almacen_tree" model="ir.ui.view">
            <field name="name">teloconnect.almacen.list</field>
            <field name="model">teloconnect.almacen</field>
            <field name="arch" type="xml">
                <list string="Despachos de Almacén">
                    <field name="name"/>
                    <field name="backoffice_id"/>
                    <field name="client_name"/>
                    <field name="technician_id"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_teloconnect_almacen" model="ir.actions.act_window">
            <field name="name">Despacho de Almacén</field>
            <field name="res_model">teloconnect.almacen</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu items -->
        <menuitem id="menu_teloconnect_root" name="TeloConnect ERP" sequence="10"/>
        <menuitem id="menu_teloconnect_almacen" name="Gestión de Almacén" parent="menu_teloconnect_root" action="action_teloconnect_almacen" sequence="10"/>

    </data>
</odoo>