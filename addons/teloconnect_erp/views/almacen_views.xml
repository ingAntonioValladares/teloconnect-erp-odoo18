<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Secuencia Automática para Despachos de Almacén -->
        <record id="seq_teloconnect_almacen" model="ir.sequence">
            <field name="name">Secuencia Despacho Almacén</field>
            <field name="code">teloconnect.almacen</field>
            <field name="prefix">DESP/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Vista Formulario para Almacén -->
        <record id="view_teloconnect_almacen_form" model="ir.ui.view">
            <field name="name">teloconnect.almacen.form</field>
            <field name="model">teloconnect.almacen</field>
            <field name="arch" type="xml">
                <form string="Despacho de Almacén">
                    <header>
                        <button name="action_assign_equipment" string="Confirmar Despacho y Asignar Equipos" type="object" class="btn-primary" invisible="state == 'entregado_tecnico'"/>
                        <field name="state" widget="statusbar" statusbar_visible="pendiente_asig,equipos_asignados,entregado_tecnico"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Referencia Comercial">
                                <field name="backoffice_id"/>
                                <field name="client_name"/>
                                <field name="district"/>
                                <field name="installation_address"/>
                            </group>
                            <group string="Logística y Cuadrilla">
                                <field name="technician_id"/>
                                <field name="dispatch_date"/>
                                <field name="deco_qty_required"/>
                                <field name="repeater_qty_required"/>
                            </group>
                        </group>
                        <group string="Control de Activos Fijos (Trazabilidad)">
                            <field name="deco_series" placeholder="Ingrese las series de los decodificadores separadas por comas..."/>
                            <field name="repeater_series" placeholder="Ingrese las direcciones MAC de los repetidores separadas por comas..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Lista para Almacén -->
        <record id="view_teloconnect_almacen_tree" model="ir.ui.view">
            <field name="name">teloconnect.almacen.list</field>
            <field name="model">teloconnect.almacen</field>
            <field name="arch" type="xml">
                <list string="Despachos de Almacén">
                    <field name="name"/>
                    <field name="backoffice_id"/>
                    <field name="client_name"/>
                    <field name="district"/>
                    <field name="technician_id"/>
                    <field name="state" widget="badge" decoration-warning="state == 'pendiente_asig'" decoration-success="state == 'entregado_tecnico'"/>
                </list>
            </field>
        </record>

        <!-- Acción de Ventana para Almacén -->
        <record id="action_teloconnect_almacen" model="ir.actions.act_window">
            <field name="name">Gestión de Almacén</field>
            <field name="res_model">teloconnect.almacen</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menú de Almacén -->
        <menuitem id="menu_teloconnect_almacen" 
                  name="Gestión de Almacén" 
                  parent="menu_teloconnect_root" 
                  action="action_teloconnect_almacen" 
                  sequence="10"/>

    </data>
</odoo>