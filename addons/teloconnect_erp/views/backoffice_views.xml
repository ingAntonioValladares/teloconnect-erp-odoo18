<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Secuencia Automática para el Back Office -->
        <record id="seq_teloconnect_backoffice" model="ir.sequence">
            <field name="name">Secuencia Back Office TeloConnect</field>
            <field name="code">teloconnect.backoffice</field>
            <field name="prefix">BO/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Menú Principal Raíz -->
        <menuitem id="menu_teloconnect_root" 
                  name="TeloConnect ERP" 
                  web_icon="teloconnect_erp,static/description/icon.png"
                  sequence="10"/>

        <!-- Vista Formulario para Back Office -->
        <record id="view_teloconnect_backoffice_form" model="ir.ui.view">
            <field name="name">teloconnect.backoffice.form</field>
            <field name="model">teloconnect.backoffice</field>
            <field name="arch" type="xml">
                <form string="Orden de Back Office">
                    <header>
                        <button name="action_validate" string="Enviar a Validación" type="object" class="btn-primary" invisible="state not in ('draft', 'en_correcion')"/>
                        <button name="action_approve" string="Aprobar Orden" type="object" class="btn-success" invisible="state != 'validation'"/>
                        <button name="action_return_correction" string="Devolver para Corrección" type="object" invisible="state != 'validation'"/>
                        <button name="action_reject" string="Rechazar" type="object" class="btn-danger" invisible="state != 'validation'"/>
                        <button name="action_draft" string="Volver a Borrador" type="object" invisible="state != 'rejected'"/>
                        <button name="action_register_installation_result" string="Guardar Resultado de Visita" type="object" class="btn-primary" invisible="state not in ('approved', 'rescheduled', 'not_installed') or not warehouse_delivered"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,validation,en_correcion,approved,rescheduled,not_installed,installed,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <field name="warehouse_delivered" invisible="1"/>
                        <group>
                            <group string="Datos del Cliente">
                                <field name="client_name"/>
                                <field name="client_dni" required="1"/>
                                <field name="client_phone"/>
                                <field name="client_age"/>
                                <field name="province"/>
                                <field name="district"/>
                                <field name="installation_address"/>
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                            <group string="Resultado de Visita Técnica" invisible="state not in ('approved', 'rescheduled', 'not_installed', 'installed')">
                                <field name="installation_result" readonly="state == 'installed'"/>
                                <field name="installation_category_id"
                                       invisible="installation_result == 'installed'"
                                       required="installation_result in ('not_installed', 'rescheduled')"
                                       domain="[('active', '=', True)]"/>
                                <field name="installation_note"
                                       invisible="installation_result == 'installed'"
                                       required="installation_result in ('not_installed', 'rescheduled')"
                                       placeholder="Ej.: Cliente reagendó por disponibilidad de tiempo."/>
                                <field name="rescheduled_install_date"
                                       invisible="installation_result != 'rescheduled'"
                                       required="installation_result == 'rescheduled'"/>
                                <field name="actual_install_date" readonly="1" invisible="state != 'installed'"/>
                            </group>
                            <group string="Equipos Requeridos &amp; Auditoría">
                                <field name="ont_qty"/>
                                <field name="deco_qty"/>
                                <field name="repeater_qty"/>
                                <field name="rejection_reason" invisible="state not in ('validation', 'rejected')" required="state == 'rejected'"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Lista para Back Office -->
        <record id="view_teloconnect_backoffice_tree" model="ir.ui.view">
            <field name="name">teloconnect.backoffice.list</field>
            <field name="model">teloconnect.backoffice</field>
            <field name="arch" type="xml">
                <list string="Órdenes de Back Office">
                    <field name="name"/>
                    <field name="client_name"/>
                    <field name="district"/>
                    <field name="ont_qty"/>
                    <field name="deco_qty"/>
                    <field name="repeater_qty"/>
                    <field name="rescheduled_install_date" optional="show"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('validation', 'approved', 'rescheduled')" decoration-success="state == 'installed'" decoration-danger="state in ('rejected', 'not_installed')"/>
                </list>
            </field>
        </record>

        <!-- Acción de Ventana para Back Office -->
        <record id="action_teloconnect_backoffice" model="ir.actions.act_window">
            <field name="name">Órdenes de Back Office</field>
            <field name="res_model">teloconnect.backoffice</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menú de Back Office -->
        <menuitem id="menu_teloconnect_backoffice" 
                  name="Back Office" 
                  parent="menu_teloconnect_root" 
                  action="action_teloconnect_backoffice" 
                  sequence="10"/>

    </data>
</odoo>